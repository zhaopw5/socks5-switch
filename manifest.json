{
  "manifest_version": 3,
  "name": "SOCKS5",
  "version": "0.2.0",
  "description": "把浏览器的流量交给本地 SOCKS5（ssh -D、Clash、v2ray 等），一键开关。",
  "permissions": ["proxy", "storage"],
  "host_permissions": ["https://api.ipify.org/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SOCKS5 · 已关闭",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/off/16.png",
      "32": "icons/off/32.png",
      "48": "icons/off/48.png",
      "128": "icons/off/128.png"
    }
  }
}
